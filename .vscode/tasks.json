{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "USB: Serial Monitor",
            "type": "process",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/serial-monitor.ps1"],
            "problemMatcher": []
        },
        {
            "label": "DFU: Setup",
            "type": "process",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/setup-dfu.ps1"],
            "problemMatcher": []
        },
        {
            "label": "DFU: List",
            "type": "process",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dfu.ps1", "-Action", "List"],
            "problemMatcher": []
        },
        {
            "label": "DFU: Flash and Verify",
            "type": "process",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dfu.ps1", "-Action", "Flash"],
            "dependsOn": "CMake: Build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Configure",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}/template",
                "-B", "${workspaceFolder}/out/build/windows",
                "-G", "Ninja",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake: Build",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/out/build/windows"],
            "dependsOn": "CMake: Configure",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$gcc"
        },
        {
            "label": "CMake: Clean",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/out/build/windows", "--target", "clean"],
            "problemMatcher": []
        }
    ]
}
