{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Questao (b): Reaction Tests",
            "type": "process",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/test-reaction.ps1"],
            "problemMatcher": []
        },
        {
            "label": "Questao (a): Button Tests",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/test-button.ps1"
            ],
            "problemMatcher": []
        },
        {
            "label": "USB: Serial Monitor",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/serial-monitor.ps1"
            ],
            "problemMatcher": []
        },
        {
            "label": "DFU: Setup",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/setup-dfu.ps1"
            ],
            "problemMatcher": []
        },
        {
            "label": "DFU: List",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/dfu.ps1",
                "-Action",
                "List"
            ],
            "problemMatcher": []
        },
        {
            "label": "DFU: Flash and Verify",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/project.ps1",
                "-Question",
                "${input:question}",
                "-Action",
                "Flash"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake: Configure",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/project.ps1",
                "-Question",
                "${input:question}",
                "-Action",
                "Configure"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake: Build",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/project.ps1",
                "-Question",
                "${input:question}",
                "-Action",
                "Build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "CMake: Clean",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/project.ps1",
                "-Question",
                "${input:question}",
                "-Action",
                "Clean"
            ],
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "question",
            "type": "pickString",
            "description": "Questao da Atividade 3 (d ainda pendente)",
            "options": [
                "a",
                "b",
                "c",
                "d"
            ],
            "default": "c"
        }
    ]
}
